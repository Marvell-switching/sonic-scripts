diff --git a/platform/components/docker-gbsyncd-mrvl.dep b/platform/components/docker-gbsyncd-mrvl.dep
new file mode 100644
index 00000000..da5b2ff3
--- /dev/null
+++ b/platform/components/docker-gbsyncd-mrvl.dep
@@ -0,0 +1,12 @@
+DPATH       := $($(DOCKER_GBSYNCD_BASE)_PATH)
+DEP_FILES   := $(SONIC_COMMON_FILES_LIST)
+DEP_FILES   += platform/components/docker-gbsyncd-mrvl.mk
+DEP_FILES   += platform/components/docker-gbsyncd-mrvl.dep
+DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
