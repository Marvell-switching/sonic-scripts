diff --git a/platform/marvell-prestera/sswsyncd.dep b/platform/marvell-prestera/sswsyncd.dep
new file mode 100644
index 000000000..7aae9b13c
--- /dev/null
+++ b/platform/marvell-prestera/sswsyncd.dep
@@ -0,0 +1,7 @@
+DPATH       := $(PLATFORM_PATH)/../broadcom/sswsyncd
+DEP_FILES   := $(SONIC_COMMON_FILES_LIST) platform/marvell-prestera/sswsyncd.mk
+DEP_FILES   += $(wildcard $(DPATH)/*)
+
+$(SSWSYNCD)_CACHE_MODE  := GIT_CONTENT_SHA
+$(SSWSYNCD)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
+$(SSWSYNCD)_DEP_FILES   := $(DEP_FILES)
diff --git a/platform/marvell-prestera/sswsyncd.mk b/platform/marvell-prestera/sswsyncd.mk
new file mode 100644
index 000000000..d8000a30d
--- /dev/null
+++ b/platform/marvell-prestera/sswsyncd.mk
@@ -0,0 +1,4 @@
+SSWSYNCD = sswsyncd_1.0.0_$(CONFIGURED_ARCH).deb
+$(SSWSYNCD)_SRC_PATH = $(PLATFORM_PATH)/../broadcom/sswsyncd
+
+SONIC_DPKG_DEBS += $(SSWSYNCD)
