+/*
+ * Set Gearbox admin state. A 1:1 system-side port follows the interface.
+ * A shared system-side port is brought up by the first interface going
+ * admin up and brought down by the last interface going admin down; the
+ * line-side port always follows the interface.
+ */
+bool PortsOrch::setGearboxPortsAdminState(const Port &port, bool up)
+{
+    sai_object_id_t systemPort;
+    sai_attribute_t attr;
+    sai_status_t status;
+
+    SWSS_LOG_ENTER();
+
+    if (!getDestPortId(port.m_port_id, PHY_PORT_TYPE, systemPort) ||
+        m_gearboxSharedSystemPorts.find(systemPort) == m_gearboxSharedSystemPorts.end())
+    {
+        if (!setGearboxPortAttr(port, PHY_PORT_TYPE, SAI_PORT_ATTR_ADMIN_STATE, &up, false))
+        {
+            return false;
+        }
+        return setGearboxPortAttr(port, LINE_PORT_TYPE, SAI_PORT_ATTR_ADMIN_STATE, &up, false);
+    }
+
+    auto &adminUpPorts = m_gearboxSharedSystemPortAdminUp[systemPort];
+
+    attr.id = SAI_PORT_ATTR_ADMIN_STATE;
+    attr.value.booldata = up;
+
+    if (up)
+    {
+        if (adminUpPorts.empty())
+        {
+            SWSS_LOG_NOTICE("BOX: %s first admin up on shared system-side port 0x%" PRIx64 ", set UP",
+                    port.m_alias.c_str(), systemPort);
+            status = sai_port_api->set_port_attribute(systemPort, &attr);
+            if (status != SAI_STATUS_SUCCESS)
+            {
+                SWSS_LOG_ERROR("BOX: Failed to set shared system-side port 0x%" PRIx64 " admin UP for %s",
+                        systemPort, port.m_alias.c_str());
+                task_process_status handle_status = handleSaiSetStatus(SAI_API_PORT, status);
+                if (handle_status != task_success)
+                {
+                    return parseHandleSaiStatusFailure(handle_status);
+                }
+            }
+        }
+
+        if (!setGearboxPortAttr(port, LINE_PORT_TYPE, SAI_PORT_ATTR_ADMIN_STATE, &up, false))
+        {
+            return false;
+        }
+
+        adminUpPorts.insert(port.m_port_id);
+        return true;
+    }
+
+    if (!setGearboxPortAttr(port, LINE_PORT_TYPE, SAI_PORT_ATTR_ADMIN_STATE, &up, false))
+    {
+        return false;
+    }
+
+    adminUpPorts.erase(port.m_port_id);
+
+    if (!adminUpPorts.empty())
+    {
+        SWSS_LOG_NOTICE("BOX: %s admin down, shared system-side port 0x%" PRIx64 " still used by %zu ports",
+                port.m_alias.c_str(), systemPort, adminUpPorts.size());
+        return true;
+    }
+
+    SWSS_LOG_NOTICE("BOX: %s last admin down on shared system-side port 0x%" PRIx64 ", set DOWN",
+            port.m_alias.c_str(), systemPort);
+    status = sai_port_api->set_port_attribute(systemPort, &attr);
+    if (status != SAI_STATUS_SUCCESS)
+    {
+        SWSS_LOG_ERROR("BOX: Failed to set shared system-side port 0x%" PRIx64 " admin DOWN for %s",
+                systemPort, port.m_alias.c_str());
+        task_process_status handle_status = handleSaiSetStatus(SAI_API_PORT, status);
+        if (handle_status != task_success)
+        {
+            return parseHandleSaiStatusFailure(handle_status);
+        }
+    }
+
+    return true;
+}
