+/*
+ * Remove the Gearbox objects of a deleted interface: its port connector and
+ * line-side port, and the system-side port once no interface uses it. A
+ * shared system-side port that stays in use is set admin down if the deleted
+ * interface was its last admin up user.
+ */
+void PortsOrch::deInitGearboxPort(const Port &port)
+{
+    sai_object_id_t systemPort;
+    sai_object_id_t linePort;
+    sai_status_t status;
+
+    SWSS_LOG_ENTER();
+
+    auto lanesIt = m_gearboxPortListLaneMap.find(port.m_port_id);
+    if (!m_gearboxEnabled || lanesIt == m_gearboxPortListLaneMap.end())
+    {
+        return;
+    }
+
+    systemPort = get<0>(lanesIt->second);
+    linePort = get<1>(lanesIt->second);
+
+    /* Remove port connector, then line-side port */
+    auto connIt = m_gearboxPortConnectorMap.find(port.m_port_id);
+    if (connIt != m_gearboxPortConnectorMap.end())
+    {
+        status = sai_port_api->remove_port_connector(connIt->second);
+        if (status != SAI_STATUS_SUCCESS)
+        {
+            SWSS_LOG_ERROR("BOX: Failed to remove Gearbox port connector 0x%" PRIx64 " for %s, status:%d",
+                    connIt->second, port.m_alias.c_str(), status);
+        }
+        m_gearboxPortConnectorMap.erase(connIt);
+    }
+
+    gb_port_stat_manager.clearCounterIdList(linePort);
+    status = sai_port_api->remove_port(linePort);
+    if (status != SAI_STATUS_SUCCESS)
+    {
+        SWSS_LOG_ERROR("BOX: Failed to remove Gearbox line-side port 0x%" PRIx64 " for %s, status:%d",
+                linePort, port.m_alias.c_str(), status);
+    }
+    saiOidToAlias.erase(linePort);
+    m_gbcounterTable->hdel("", port.m_alias + "_line");
+    m_gbcounterTable->hdel("", port.m_alias + "_system");
+    m_gearboxPortListLaneMap.erase(lanesIt);
+
+    /* Detach from the system-side port */
+    auto adminIt = m_gearboxSharedSystemPortAdminUp.find(systemPort);
+    bool wasAdminUp = adminIt != m_gearboxSharedSystemPortAdminUp.end() &&
+                      adminIt->second.erase(port.m_port_id) > 0;
+
+    auto intfIt = m_gearboxInterfaceMap.find(port.m_index);
+    if (intfIt == m_gearboxInterfaceMap.end())
+    {
+        SWSS_LOG_ERROR("BOX: %s index %d not in gearbox interface map, keep system-side port 0x%" PRIx64,
+                port.m_alias.c_str(), port.m_index, systemPort);
+        return;
+    }
+
+    gearbox_system_port_t &gbSystemPort =
+        m_gearboxSystemPortMap[make_pair(intfIt->second.phy_id, intfIt->second.system_lanes)];
+    gbSystemPort.members.erase(port.m_port_id);
+
+    if (!gbSystemPort.members.empty())
+    {
+        SWSS_LOG_NOTICE("BOX: %s removed, shared system-side port 0x%" PRIx64 " still used by %zu ports",
+                port.m_alias.c_str(), systemPort, gbSystemPort.members.size());
+
+        /* Name the system-side port after a remaining interface */
+        if (saiOidToAlias.count(systemPort) && saiOidToAlias[systemPort] == port.m_alias)
+        {
+            saiOidToAlias[systemPort] = saiOidToAlias[*gbSystemPort.members.begin()];
+        }
+
+        if (wasAdminUp && adminIt->second.empty())
+        {
+            sai_attribute_t attr;
+            attr.id = SAI_PORT_ATTR_ADMIN_STATE;
+            attr.value.booldata = false;
+            status = sai_port_api->set_port_attribute(systemPort, &attr);
+            if (status != SAI_STATUS_SUCCESS)
+            {
+                SWSS_LOG_ERROR("BOX: Failed to set shared system-side port 0x%" PRIx64 " admin DOWN on %s removal",
+                        systemPort, port.m_alias.c_str());
+            }
+        }
+        return;
+    }
+
+    /* Last interface on this system-side port */
+    gb_port_stat_manager.clearCounterIdList(systemPort);
+    status = sai_port_api->remove_port(systemPort);
+    if (status != SAI_STATUS_SUCCESS)
+    {
+        SWSS_LOG_ERROR("BOX: Failed to remove Gearbox system-side port 0x%" PRIx64 " for %s, status:%d",
+                systemPort, port.m_alias.c_str(), status);
+    }
+    else
+    {
+        SWSS_LOG_NOTICE("BOX: Removed Gearbox system-side port 0x%" PRIx64 " with %s",
+                systemPort, port.m_alias.c_str());
+    }
+    saiOidToAlias.erase(systemPort);
+    m_gearboxSharedSystemPorts.erase(systemPort);
+    m_gearboxSharedSystemPortAdminUp.erase(systemPort);
+    gbSystemPort.oid = SAI_NULL_OBJECT_ID;
+}
